# ---------------------------------------------------------------------------
# Supabase — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores do seu
# projeto em https://supabase.com/dashboard (Project Settings → API).
# ---------------------------------------------------------------------------

# URL do projeto Supabase (pública — exposta ao navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima (pública — exposta ao navegador, protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de service role (SECRETA — use apenas no servidor).
# Necessária para a rota /api/admin/create-user criar usuários.
# NUNCA commite este valor nem o exponha em código do cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---------------------------------------------------------------------------
# Asaas — cobrança da assinatura (SECRETO — use apenas no servidor)
# Gere a chave em https://sandbox.asaas.com (Integrações → Chave de API).
# Sem ela, o checkout responde "Pagamento indisponível" em vez de cobrar.
# ---------------------------------------------------------------------------

# Chave de API da conta Asaas.
ASAAS_API_KEY=

# Base da API. Sandbox (padrão) ou produção: https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Token do webhook (Asaas → Integrações → Webhooks → Auth Token).
# O Asaas envia este valor no header `asaas-access-token` a cada notificação.
# Enquanto estiver vazio, /api/webhooks/asaas recusa todos os eventos (500).
# Use 32–255 caracteres, sem espaços, gerados pelo botão "Gerar token".
# Passo a passo completo: docs/asaas-webhook.md
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Resend — e-mail transacional (SECRETO — use apenas no servidor)
# Usado pelo e-mail de boas-vindas enviado no cadastro (/api/signup).
# Passo a passo completo: docs/email-boas-vindas.md
# ---------------------------------------------------------------------------

# Chave de API da conta Resend (https://resend.com/api-keys).
# Enquanto estiver vazia o cadastro NÃO envia e-mail (apenas um aviso no log).
RESEND_API_KEY=

# Remetente no formato `Nome <endereco@dominio>`.
# O domínio precisa estar verificado no Resend (Domains → Verify).
EMAIL_FROM="Ipepper <nao-responda@ipepper.com.br>"

# Endereço de resposta (vira o "Responder para" e o contato de suporte no
# rodapé do e-mail). Opcional.
EMAIL_REPLY_TO=

# URL pública da plataforma — base dos links do e-mail (painel, cardápio).
# Sem barra no final. Padrão: https://ipepper.com.br
NEXT_PUBLIC_APP_URL=https://ipepper.com.br

# URL absoluta do logotipo do cabeçalho. Opcional: por padrão usa
# `${NEXT_PUBLIC_APP_URL}/logotipo-email.png` (public/logotipo-email.png).
# Use PNG/JPG: Outlook não renderiza WebP e o Gmail bloqueia SVG.
EMAIL_LOGO_URL=
