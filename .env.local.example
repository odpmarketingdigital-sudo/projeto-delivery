# ---------------------------------------------------------------------------
# Supabase — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores do seu
# projeto em https://supabase.com/dashboard (Project Settings → API).
# ---------------------------------------------------------------------------

# URL do projeto Supabase (pública — exposta ao navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima (pública — exposta ao navegador, protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de service role (SECRETA — use apenas no servidor).
# Necessária para a rota /api/admin/create-user criar usuários.
# NUNCA commite este valor nem o exponha em código do cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---------------------------------------------------------------------------
# Asaas — cobrança da assinatura (SECRETO — use apenas no servidor)
# Gere a chave em https://sandbox.asaas.com (Integrações → Chave de API).
# Sem ela, o checkout responde "Pagamento indisponível" em vez de cobrar.
# ---------------------------------------------------------------------------

# Chave de API da conta Asaas.
# ATENÇÃO: sandbox e produção usam chaves DIFERENTES — use a chave do mesmo
# ambiente apontado em ASAAS_API_URL, senão o Asaas recusa com 401/403.
ASAAS_API_KEY=

# Base da API. Padrão (vazio): sandbox — https://sandbox.asaas.com/api/v3.
# Em produção use https://api.asaas.com/v3 (o segmento /v3 é completado
# automaticamente quando você informa apenas o domínio).
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Alternativa usada quando ASAAS_API_URL está vazia: `production`/`prod`
# aponta para a API de produção. Qualquer outro valor (ou vazio) = sandbox.
# ASAAS_ENV=sandbox

# Token do webhook (Asaas → Integrações → Webhooks → Auth Token).
# O Asaas envia este valor no header `asaas-access-token` a cada notificação.
# Enquanto estiver vazio, /api/webhooks/asaas recusa todos os eventos (500).
# Use 32–255 caracteres, sem espaços, gerados pelo botão "Gerar token".
# Passo a passo completo: docs/asaas-webhook.md
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Resend — e-mail transacional (SECRETO — use apenas no servidor)
# Usado pelo e-mail de boas-vindas enviado no cadastro (/api/signup).
# Passo a passo completo: docs/email-boas-vindas.md
# ---------------------------------------------------------------------------

# Chave de API da conta Resend (https://resend.com/api-keys).
# Enquanto estiver vazia o cadastro NÃO envia e-mail (apenas um aviso no log).
RESEND_API_KEY=

# Remetente no formato `Nome <endereco@dominio>`.
# O domínio precisa estar verificado no Resend (Domains → Verify).
EMAIL_FROM="Ipepper <nao-responda@ipepper.com.br>"

# Endereço de resposta (vira o "Responder para" e o contato de suporte no
# rodapé do e-mail). Opcional.
EMAIL_REPLY_TO=

# URL pública da plataforma — base dos links do e-mail (painel, cardápio).
# Sem barra no final. Padrão: https://ipepper.com.br
NEXT_PUBLIC_APP_URL=https://ipepper.com.br

# ---------------------------------------------------------------------------
# Domínio canônico e verificação de marca (Google Cloud OAuth / Search Console)
# ---------------------------------------------------------------------------

# Domínio canônico das páginas institucionais (landing, /privacidade, /termos).
# Alimenta canonical, Open Graph, robots.txt e sitemap.xml.
# Deve ser o MESMO endereço informado em "App domain", "Privacy policy URL" e
# "Terms of service URL" na tela de consentimento OAuth, e um só dos dois
# (com ou sem www) deve responder 200 — o outro precisa redirecionar 301.
# Padrão quando ausente: NEXT_PUBLIC_APP_URL ou https://www.ipepper.com.br
NEXT_PUBLIC_SITE_URL=https://www.ipepper.com.br

# Código de verificação do Google Search Console (propriedade por prefixo de URL).
# Gera <meta name="google-site-verification" content="..."> no <head>.
# Opcional: a verificação por DNS TXT dispensa esta variável.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# URL absoluta do logotipo do cabeçalho. Opcional: por padrão usa
# `${NEXT_PUBLIC_APP_URL}/logotipo-email.png` (public/logotipo-email.png).
# Use PNG/JPG: Outlook não renderiza WebP e o Gmail bloqueia SVG.
EMAIL_LOGO_URL=

# ---------------------------------------------------------------------------
# Google Maps — autocomplete de endereço + distância por rota
# Guia completo: docs/google-maps-delivery.md
#
# APIs necessárias no Google Cloud (projeto → APIs e serviços → Biblioteca):
#   • Places API (New)  → sugestões de endereço no checkout
#   • Routes API        → distância/tempo de carro usados na taxa de entrega
#
# Sem estas variáveis o sistema NÃO quebra: o checkout fica sem sugestões e a
# distância é calculada em linha reta (Haversine) a partir do CEP.
# ---------------------------------------------------------------------------

# Chave PÚBLICA usada no navegador pelo componente de autocomplete.
# Restrinja por HTTP referrer (ex.: https://ipepper.com.br/* e
# http://localhost:3000/*) e habilite SOMENTE a Places API (New) / Maps JS.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chave de SERVIDOR para a Routes API (nunca vai para o navegador).
# Restrinja por IP da hospedagem (ou deixe sem restrição de referrer) e
# habilite somente a Routes API. Se ficar vazia, o servidor usa a chave
# pública acima como fallback (precisa permitir chamadas de servidor).
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Google Gemini — importação de cardápio por IA (SECRETO — só no servidor)
# Lê PDF/foto do cardápio antigo em POST /api/ai/import-menu.
#
# Gere a chave em https://aistudio.google.com/apikey e mantenha-a apenas no
# servidor. Sem ela a importação responde "Importação por IA não configurada".
# ---------------------------------------------------------------------------

# Chave de API do Google AI Studio.
GEMINI_API_KEY=

# Modelo usado na extração (padrão: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

